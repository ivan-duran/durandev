---
import { Plus } from "@lucide/astro";
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  title: string;
  photo?: string;
  /** Optional photo used below the md breakpoint instead of `photo` */
  photoMobile?: string;
  Content: any;
}

const { locale, title, photo, photoMobile, Content } = Astro.props;
const copy = t(locale);
---

<section id="about" class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="card bg-base-200 shadow-sm overflow-hidden flex flex-col md:flex-row">
      {
        photo && (
          <figure class="w-full md:w-48 md:shrink-0">
            <picture class="contents">
              {photoMobile && <source media="(min-width: 48rem)" srcset={photo} />}
              <img
                src={photoMobile ?? photo}
                alt={title}
                class="w-full aspect-[5/4] md:aspect-auto md:h-full object-cover object-top"
                loading="lazy"
              />
            </picture>
          </figure>
        )
      }

      <div class="card-body min-w-0">
        <h2 class="card-title text-2xl break-words">{title}</h2>

        <div class="text-lg min-w-0 break-words">
          <Content />
        </div>

        <div class="card-actions justify-end">
          <div class="tooltip" data-tip={copy.labels.moreAboutMe}>
            <a
              href="https://linkedin.com/in/ivan-duran-40745a2ba/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <Plus class="size-5" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
